{
    "name": "aryeo/api-first",
    "description": "Conventions for versioned, attribute-routed JSON APIs, with controller and resource generators.",
    "license": "MIT",
    "type": "library",
    "repositories": {
        "artifactory": {
            "type": "composer",
            "url": "https://artifactory.zgtools.net/artifactory/api/composer/listing-and-vendor-management-composer/",
            "only": ["aryeo/*", "zillow/*"]
        }
    },
    "require": {
        "php": "^8.4",
        "aryeo/api-resource-schema": "0.0.22",
        "laravel/framework": "^12.37 || ^13",
        "laravel/prompts": "^0.3.8",
        "nikic/php-parser": "^5.7",
        "phpstan/phpstan": "^2.1",
        "symfony/console": "^7.4 || ^8.0",
        "aryeo/tooling-laravel": "0.0.41",
        "aryeo/attribute-routing": "0.0.17",
        "aryeo/entities": "0.0.22",
        "aryeo/request-casts": "0.0.16",
        "aryeo/request-authorizers-validators": "0.0.15",
        "aryeo/event-log": "0.0.10",
        "aryeo/webhooks": "0.0.9"
    },
    "require-dev": {
        "nesbot/carbon": "^3.10",
        "orchestra/testbench": "^10.6 || ^11",
        "orchestra/testbench-core": "^10.7 || ^11",
        "pestphp/pest": "^4.1",
        "phpunit/phpunit": "^12.4.1 || ^13"
    },
    "autoload": {
        "psr-4": {
            "Support\\Database\\": "src/Support/Database",
            "Support\\Entities\\": "src/Support/Entities",
            "Support\\Http\\Api\\": "src/Support/Http/Api",
            "Tooling\\Http\\Api\\": "src/Tooling/Http/Api"
        },
        "exclude-from-classmap": [
            "*Test.php",
            "*TestCases.php",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Justin Seliga",
            "email": "justinsel@zillowgroup.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "aryeo/tooling-laravel": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Database\\Query\\Grammars\\Rfc3339Extended\\Providers\\Provider",
                "Support\\Http\\Api\\Providers\\Provider"
            ]
        },
        "tooling": {
            "phpstan": {
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                },
                "rules": "tooling/phpstan/rules.neon"
            },
            "rector": {
                "config": {
                    "paths": [
                        "src",
                        "tests/Fixtures/Support"
                    ]
                }
            },
            "pint": {
                "config": {
                    "paths": [
                        "src",
                        "tests"
                    ]
                }
            }
        }
    }
}
